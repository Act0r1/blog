---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const tags = [...new Set(posts.map((post: any) => post.data.tags).flat())];
---

<Layout title="insafdev | Tags">
	<section>
		<a href="/" class="text-dim hover:text-ember transition-colors mb-8 inline-block text-sm">
			&larr; Home
		</a>
		<h1 class="text-2xl font-semibold tracking-tight mb-8">
			Tags
		</h1>
		<div class="flex flex-wrap gap-2">
			{tags.length > 0 ? (
				tags.map((tag) => (
					<a
						href={`/tags/${tag}`}
						class="text-sm text-dim bg-chip rounded-md px-3 py-1.5 hover:text-cream transition-colors"
					>
						{tag}
					</a>
				))
			) : (
				<p class="text-dim">No tags yet.</p>
			)}
		</div>
	</section>
</Layout>